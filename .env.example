# ===== OKX SA API (from web3.okx.com — API key / secret / passphrase) =====
# Drives both the x402 facilitator (service fee) and the OKX DEX aggregator (swaps).
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Optional pass-through relay when the network can't reach web3.okx.com. Empty in prod.
OKX_BASE_URL=

# ===== Seller (Oddsmith treasury — receives all x402 service fees, USDt0 on X Layer) =====
# Give this service its OWN treasury address. `npm run verify` re-derives revenue
# from every USDt0 transfer into PAY_TO, so an address shared with another service
# would report that service's settlements as this one's.
PAY_TO=0x...
# Signs MPP session vouchers; MUST be the private key of PAY_TO
MPP_MERCHANT_PRIVATE_KEY=0x...

# ===== MPP =====
# REQUIRED — any high-entropy string; signs the MPP 402 challenges. If it is blank,
# /api/mandate and /session/desk both 500 ("Missing secret key").
MPP_SECRET_KEY=
MPP_ESCROW=0x5E550002e64FaF79B41D89fE8439eEb1be66CE3b
# Signal-partner wallet receiving 10% of every MPP mandate charge
SPLIT_PARTNER=0x...

# ===== Buyer agent (patron demo — REAL USDt0 on X Layer) =====
BUYER_PRIVATE_KEY=0x...

# ===== Execution desk wallet (holds USDt0, signs the real swaps on X Layer) =====
EXECUTION_PRIVATE_KEY=0x...

# ===== Risk limits + execution mode =====
# "live" places REAL on-chain swaps; anything else = dry-run preview only.
EXECUTION_MODE=paper
MAX_STAKE_PER_TRADE_USD=1
MAX_STAKE_PER_DAY_USD=5
DEFAULT_SLIPPAGE_PERCENT=1
MAX_SLIPPAGE_PERCENT=3

# ===== Chain =====
XLAYER_RPC=https://rpc.xlayer.tech

# ===== Server =====
PORT=4000
