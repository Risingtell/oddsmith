# ===== OKX SA API (from web3.okx.com — API key / secret / passphrase) =====
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Optional: alternate OKX API host (pass-through relay when the network can't
# reach web3.okx.com). Leave empty in production (Render reaches it directly).
OKX_BASE_URL=

# ===== Seller (Oddsmith treasury — receives all x402 service fees, USDt0 on X Layer) =====
PAY_TO=0x...
# Signs MPP session vouchers; MUST be the private key of PAY_TO
MPP_MERCHANT_PRIVATE_KEY=0x...

# ===== MPP =====
MPP_SECRET_KEY=
MPP_ESCROW=0x5E550002e64FaF79B41D89fE8439eEb1be66CE3b
# Data/research-partner wallet receiving 10% of every MPP mandate charge
SPLIT_PARTNER=0x...

# ===== Buyer agent (patron demo — REAL USDt0 on X Layer mainnet) =====
BUYER_PRIVATE_KEY=0x...

# ===== Execution engine (Polymarket, Polygon chain 137) =====
# The onchainos CLI + polymarket-plugin binary must be installed and logged in
# on the host; Oddsmith shells out to them. Override the binary paths if not on PATH.
ONCHAINOS_BIN=onchainos
POLYMARKET_BIN=polymarket-plugin
# Strategy id reported through OKX's strategy-attribution rail on every fill.
STRATEGY_ID=oddsmith
# Live vs paper. "live" places REAL on-chain orders; anything else = dry-run only.
EXECUTION_MODE=paper
# Hard risk caps (USD). Fail-closed: an order above either cap is refused.
MAX_STAKE_PER_TRADE_USD=5
MAX_STAKE_PER_DAY_USD=25
# Refuse to buy an outcome priced above this (0-1). Discipline: never chase.
DEFAULT_MAX_PRICE=0.97

# ===== Chain =====
XLAYER_RPC=https://rpc.xlayer.tech
# Verifier re-derives Polygon fills from this RPC (public, high getLogs limit).
POLYGON_RPC=https://polygon-rpc.com

# ===== Server =====
PORT=4000
